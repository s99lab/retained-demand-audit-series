title: "Retained-Demand Audit Series for Institutionally Connected Digital Assets"
authors:
  - family-names: "Meta"
    given-names: "S."
doi: "10.17605/OSF.IO/VQDUJ"
url: "https://github.com/s99lab/retained-demand-audit-series"
